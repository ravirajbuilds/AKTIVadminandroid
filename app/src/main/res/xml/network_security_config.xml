<?xml version="1.0" encoding="utf-8"?>
<!--
    The AKTIV Admin app talks to the clinic's FastAPI backend, reachable two ways:

      * https://api.anubhavlifecare.in/  - the default (clinic PC -> cloudflared
        tunnel). TLS, so it needs no exception here.
      * http://192.168.29.157:8080/      - the same backend on the clinic LAN,
        used by dev builds via -PAKTIV_API_URL=. It has no certificate, and
        Android 9+ (API 28+) blocks cleartext by default, so those hosts are
        listed below.

    The base config deliberately keeps the platform's secure default (cleartext
    denied). Permitting cleartext globally would let anyone on the same network
    downgrade the public HTTPS endpoint and read patient PII and staff
    credentials off the wire.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- The on-premises clinic server and local dev/emulator hosts. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.29.157</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
